# --- Core / LLM ---
ANTHROPIC_API_KEY=

# --- Database (packages/db) ---
# Local dev default: SQLite file. Swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# --- Flights: Amadeus for Developers (https://developers.amadeus.com) ---
# Self-Service tier works for sandbox search; flight BOOKING in production
# requires Amadeus's Enterprise (Flight Create Orders) agreement — sandbox-only
# until that's signed.
AMADEUS_ENV=sandbox          # sandbox | production
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Hotels ---
# Pick ONE provider and record the decision in docs/architecture.md.
# Expedia Rapid API, Amadeus Hotel Booking API, and Booking.com Demand API
# all require a signed partner/affiliate agreement before production keys
# are issued — sandbox/test credentials are available pre-approval.
HOTEL_PROVIDER=amadeus        # amadeus | expedia_rapid | booking_demand
HOTEL_PROVIDER_ENV=sandbox    # sandbox | production
HOTEL_PROVIDER_CLIENT_ID=
HOTEL_PROVIDER_CLIENT_SECRET=

# --- Tours & activities: Viator Partner API ---
VIATOR_ENV=sandbox            # sandbox | production
VIATOR_API_KEY=

# --- Reviews/ratings: Google Places API (New) ---
# Read-only lookups used to show real ratings on the itinerary options
# comparison view -- never used to book anything. Self-serve, unlike the
# booking providers: create a key at
# https://console.cloud.google.com/apis/credentials and enable "Places API
# (New)" on the same project. Billed per request (two per candidate place:
# Text Search + Place Details), so a budget/quota cap is worth setting.
# Leave blank and options simply show "no rating available" -- the app never
# invents a rating.
GOOGLE_PLACES_API_KEY=

# --- Payments: Stripe ---
# PCI-DSS: card data must never touch our server — use Stripe Elements /
# Payment Intents on the client, only the token/intent id crosses to the API.
STRIPE_ENV=test                # test | live
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth / session (choose when wiring real user accounts) ---
AUTH_SECRET=
